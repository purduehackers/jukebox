#!/usr/bin/env bash
# Real local audio by default. Fixture modes are explicit and never alter PH ID.
set -euo pipefail
cd "$(dirname "$0")/.."
source scripts/load-local-env
[[ -x node_modules/.bin/vite ]] || npm ci --no-audit --no-fund
auth_args=()
if [[ -z ${JUKEBOX_PHID_CLIENT_ID:-} ]]; then auth_args+=(--dev-auth); fi
service_port=${JUKEBOX_SERVICE_PORT:-8980}
app_port=${JUKEBOX_APP_PORT:-5173}
worker_port=${JUKEBOX_WORKER_PORT:-8971}
worker_url=${JUKEBOX_WORKER_URL:-http://127.0.0.1:$worker_port}
fixture=false
external_worker=false
next_port=false
for arg in "$@"; do
  if $next_port; then service_port=$arg; next_port=false; fi
  case "$arg" in
    --fixture-media|--fixture-matching) fixture=true ;;
    --port) next_port=true ;;
    --port=*) service_port=${arg#--port=} ;;
    --worker|--worker=*) external_worker=true ;;
  esac
done
# Fail before starting children when an app/service port is occupied. In particular,
# do not attach this worktree's Vite to the user's existing queue service.
node --input-type=module - "$service_port" "$app_port" <<'JS'
import net from 'node:net';
for (const value of process.argv.slice(2)) {
  const port = Number(value);
  if (!Number.isInteger(port) || port < 1 || port > 65535) throw Error(`Invalid port ${value}`);
  const server = net.createServer();
  await new Promise((resolve, reject) => server.once('error', () => reject(Error(`Port ${port} is already in use; choose JUKEBOX_SERVICE_PORT / JUKEBOX_APP_PORT. Existing app left running.`))).listen(port, '127.0.0.1', resolve));
  await new Promise(resolve => server.close(resolve));
}
JS
service_pid=''
worker_pid=''
cleanup() {
  [[ -z $service_pid ]] || kill "$service_pid" 2>/dev/null || true
  [[ -z $worker_pid ]] || kill "$worker_pid" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
if ! $fixture && ! $external_worker; then
  # Reuse an already-running local worker, or start one. A configured external
  # worker is never replaced by a local worker on connection failure.
  worker_state=0
  node --input-type=module - "$worker_url" <<'JS' || worker_state=$?
try {
  const response = await fetch(process.argv[2] + '/api/status', { signal: AbortSignal.timeout(2000) });
  const body = await response.json();
  if (!response.ok || !body.limits?.jobSeconds) process.exit(1);
  if (body.capabilities?.candidateSearch !== 1) process.exit(2);
} catch { process.exit(1); }
JS
  if ((worker_state == 2)); then
    echo 'The existing audio worker needs an update. Restart scripts/run-local from this checkout, or choose an isolated JUKEBOX_WORKER_PORT. Existing worker left running.' >&2
    exit 1
  fi
  if ((worker_state != 0)); then
    if [[ -n ${JUKEBOX_WORKER_URL:-} ]]; then
      echo 'JUKEBOX_WORKER_URL is unreachable; start that audio worker or correct the URL.' >&2
      exit 1
    fi
    ./scripts/run-local --port "$worker_port" --data "${JUKEBOX_WORKER_DATA:-.local/dev-worker}" &
    worker_pid=$!
    ready=false
    for ((attempt=0; attempt<120; attempt++)); do
      kill -0 "$worker_pid" 2>/dev/null || { echo 'Audio worker failed to start.' >&2; exit 1; }
      if node --input-type=module - "$worker_url" <<'JS'
try { const r = await fetch(process.argv[2] + '/api/status', { signal: AbortSignal.timeout(1000) }); const b = await r.json(); process.exit(r.ok && b.limits?.jobSeconds && b.capabilities?.candidateSearch === 1 ? 0 : 1); } catch { process.exit(1); }
JS
      then ready=true; break; fi
      sleep .25
    done
    $ready || { echo 'Audio worker startup timed out; inspect scripts/run-local.' >&2; exit 1; }
  fi
fi
export JUKEBOX_SERVICE="http://127.0.0.1:$service_port"
JUKEBOX_ORIGIN="${JUKEBOX_ORIGIN:-http://127.0.0.1:$app_port}" JUKEBOX_WORKER_URL="$worker_url" node src/server/main.ts --port "$service_port" "${auth_args[@]}" "$@" &
service_pid=$!
# Wait for our service, so a failed startup cannot leave a misleading usable UI.
service_ready=false
for ((attempt=0; attempt<80; attempt++)); do
  kill -0 "$service_pid" 2>/dev/null || { echo 'Queue service failed to start.' >&2; exit 1; }
  if node --input-type=module - "$JUKEBOX_SERVICE" <<'JS'
try { const r = await fetch(process.argv[2] + '/healthz', { signal: AbortSignal.timeout(500) }); process.exit(r.ok ? 0 : 1); } catch { process.exit(1); }
JS
  then service_ready=true; break; fi
  sleep .1
done
$service_ready || { echo 'Queue service startup timed out.' >&2; exit 1; }
node_modules/.bin/vite --port "$app_port"

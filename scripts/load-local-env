# Sourced by local launchers after changing to the project root.
# Node parses dotenv as data; no eval/source of credential file contents.
# Existing exported environment variables take precedence over the file.
while IFS= read -r -d '' jukebox_env_entry; do
  export "$jukebox_env_entry"
done < <(node --env-file-if-exists=.env.local --input-type=module -e '
  for (const [key, value] of Object.entries(process.env)) {
    if (key.startsWith("JUKEBOX_")) process.stdout.write(`${key}=${value}\0`);
  }
')
unset jukebox_env_entry

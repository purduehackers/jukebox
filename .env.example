# Copy to .env.local once. Startup loads it automatically; never commit .env.local.
JUKEBOX_PHID_CLIENT_ID=
JUKEBOX_PHID_CLIENT_SECRET=
JUKEBOX_PHID_REDIRECT_URI=http://127.0.0.1:5173/auth/callback
# Generate once: openssl rand -base64 32
JUKEBOX_SESSION_SECRET=

# Bounded audio cache, including queued and active tracks (50 GiB).
JUKEBOX_CACHE_BYTES=53687091200

---
import Page from '../layouts/Page.astro';
import SignInGate from '../components/SignInGate.astro';
import { QueuePage } from '../../app/src/queue/QueuePage.tsx';
import '../../app/src/shared/ph-ui.css';

// Server-side gate: attendees must have a PH ID session; without one the page is
// the static Astro sign-in page and no island script is shipped.
const identity = Astro.locals.runtime.transport.sessionIdentity(Astro.request);
---

<Page title="Purdue Hackers Jukebox">
  {identity ? (
    <QueuePage client:load />
  ) : (
    <SignInGate
      returnTo="/queue"
      heading="Sign in to request"
      message="Sign in with Purdue Hackers ID to request songs for the Hack Night jukebox."
    />
  )}
</Page>

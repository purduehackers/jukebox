---
import Page from '../layouts/Page.astro';
import DitheredSoup from '../components/DitheredSoup.astro';
import '../../app/src/shared/ph-ui.css';
import '../../app/src/admin/admin.css';
---

<Page title="Purdue Hackers Jukebox — Admin">
  <div id="admin-page" class="ph-ui dark adm-root">
    <DitheredSoup fgColor="#897309" />
    <div id="admin-root" class="adm-shell"></div>
  </div>
</Page>

<script>
  import { mountAdminPage } from '../../app/src/admin/client.ts';
  const root = document.getElementById('admin-root');
  if (root) mountAdminPage(root);
</script>

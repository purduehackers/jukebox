---
import Page from '../layouts/Page.astro';
import SignInGate from '../components/SignInGate.astro';
import { AdminPage } from '../../app/src/admin/AdminPage.tsx';
import { getRuntime } from '../server/runtime.ts';
import '../../app/src/shared/ph-ui.css';

// Server-side gate: the React island (and its script) is only rendered for an
// organizer session; everyone else gets the static Astro sign-in page.
const runtime = getRuntime();
const identity = runtime.transport.sessionIdentity(Astro.request);
const allowed = !!identity && runtime.service.isAdmin(identity);
---

<Page title="Purdue Hackers Jukebox — Admin">
  {allowed ? (
    <AdminPage client:load />
  ) : identity ? (
    <SignInGate
      returnTo="/admin"
      heading="Organizer access required"
      message="This sign-in doesn't include organizer access. If your PH ID access changed recently, sign in again to refresh it."
      name={identity.displayName}
    />
  ) : (
    <SignInGate
      returnTo="/admin"
      heading="Organizer sign-in"
      message="Sign in with Purdue Hackers ID. Only organizers can control the jukebox."
    />
  )}
</Page>

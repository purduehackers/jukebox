---
import { icons, type IconName } from "./icons";

type Props = astroHTML.JSX.SVGAttributes & {
  name: IconName;
  label?: string;
};

const { name, label, class: className, ...rest } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="currentColor"
  shape-rendering="crispEdges"
  class:list={["size-4 shrink-0", className]}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
  {...rest}
  set:html={icons[name]}
/>

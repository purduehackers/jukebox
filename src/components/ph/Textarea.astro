---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'textarea'>;

const { class: className, ...rest } = Astro.props;
---

<textarea
  class:list={[
    'min-h-24 w-full min-w-0 border border-input bg-card px-3 py-2 font-sans text-[15px] text-card-foreground outline-none transition-colors duration-150 ease-quint placeholder:text-card-foreground/55 focus-visible:border-foreground disabled:cursor-not-allowed disabled:opacity-40 aria-invalid:border-ph-orange',
    className,
  ]}
  {...rest}></textarea>

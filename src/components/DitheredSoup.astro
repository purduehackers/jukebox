---
import '../../app/src/shared/dithered-soup.css';

interface Props {
  fgColor: string;
}

const { fgColor } = Astro.props;
---

<div class="ph-dither-soup" aria-hidden="true" data-fg-color={fgColor}>
  <div data-dither-soup-mount style="width: 100%; height: 100%;"></div>
</div>

<script>
  import { initDitheredSoups } from '../../app/src/shared/dithered-soup.ts';
  initDitheredSoups();
</script>

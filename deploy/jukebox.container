# Rootless Quadlet: ~/.config/containers/systemd/jukebox.container
[Unit]
Description=Jukebox

StartLimitBurst=5
StartLimitIntervalSec=1m

[Container]
Image=ghcr.io/purduehackers/jukebox:latest
AutoUpdate=registry
ContainerName=jukebox
Pod=jukebox.pod
Volume=jukebox-data:/var/lib/jukebox
EnvironmentFile=%h/env
HealthCmd=bun --no-env-file -e "fetch('http://127.0.0.1:8080/readyz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=45s
HealthOnFailure=kill
StopTimeout=15

[Service]
Restart=on-failure
TimeoutStartSec=120
TimeoutStopSec=20

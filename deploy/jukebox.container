# Rootless Quadlet: ~/.config/containers/systemd/jukebox.container
[Unit]
Description=Purdue Hackers Jukebox
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/jukebox:local
ContainerName=jukebox
PublishPort=127.0.0.1:8080:8080
Volume=jukebox-data:/var/lib/jukebox
EnvironmentFile=%h/.config/jukebox/jukebox.env
HealthCmd=bun --no-env-file -e "fetch('http://127.0.0.1:8080/readyz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=45s
HealthOnFailure=kill
StopTimeout=15

[Service]
Restart=on-failure
TimeoutStartSec=120
TimeoutStopSec=20

[Install]
WantedBy=default.target

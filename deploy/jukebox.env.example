# Install privately, e.g. /etc/jukebox.env (readable only by operator/service).
JUKEBOX_ORIGIN=https://jukebox.purduehackers.com
JUKEBOX_PHID_REDIRECT_URI=https://jukebox.purduehackers.com/auth/callback
JUKEBOX_PHID_CLIENT_ID=
JUKEBOX_PHID_CLIENT_SECRET=
# Generate once, preserve across deployments: openssl rand -base64 32
JUKEBOX_SESSION_SECRET=
JUKEBOX_SERVICE_DATA=/var/lib/jukebox/service
JUKEBOX_WORKER_DATA=/var/lib/jukebox/worker
HOST=0.0.0.0
PORT=8080
JUKEBOX_WORKER_PORT=8971

# Bounded audio cache, including queued and active tracks (50 GiB).
JUKEBOX_CACHE_BYTES=53687091200

# Optional Sentry monitoring: one DSN shared by the web authority, the browser
# pages and the audio worker. Leave empty to disable monitoring entirely.
# JUKEBOX_SENTRY_DSN=https://<public-key>@o<org>.ingest.us.sentry.io/<project-id>
# JUKEBOX_SENTRY_ENVIRONMENT=production
# JUKEBOX_SENTRY_RELEASE=
# JUKEBOX_SENTRY_TRACES_SAMPLE_RATE=0

# Example for a same-host Astro/Bun/uv deployment. Install paths/user are operator choices.
[Unit]
Description=Purdue Hackers Jukebox web app and audio worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=jukebox
Group=jukebox
WorkingDirectory=/opt/jukebox
EnvironmentFile=/etc/jukebox.env
Environment=NODE_ENV=production
ExecStart=/opt/jukebox/scripts/run-production
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=20
UMask=0077
StateDirectory=jukebox
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

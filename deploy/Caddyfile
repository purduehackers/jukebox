# Example: operator adapts paths/domain to their existing ingress.
jukebox.purduehackers.com {
    @backend path /api/* /auth/* /media/* /healthz
    handle @backend {
        reverse_proxy 127.0.0.1:8980 {
            flush_interval -1
        }
    }
    # Hashed Vite assets; missing assets must 404 rather than return index.html.
    handle /assets/* {
        root * /opt/jukebox/dist/app
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * /opt/jukebox/dist/app
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}

{
  "name": "purdue-hackers-jukebox",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "scripts/run-dev",
    "build": "bun --bun astro build",
    "build:app": "bun run build",
    "start": "scripts/run-production",
    "test": "bun test tests/*.test.ts tests/turn.test.mjs",
    "test:policy": "bun test tests/turn.test.mjs",
    "typecheck": "bun --bun tsc -p . && bun --bun tsc -p app && bun --bun astro check",
    "check": "scripts/check",
    "worker": "uv run --locked python -m jukebox.server"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/bun": "1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "postcss-prefix-selector": "^2.2.1",
    "tailwindcss": "^4.3.4",
    "typescript": "6.0.3"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "dependencies": {
    "@astrojs/node": "11.1.11",
    "@astrojs/react": "7.1.5",
    "@fontsource/inconsolata": "^5.3.0",
    "@paper-design/shaders-react": "0.0.82",
    "@purduehackers/time": "^0.7.0",
    "astro": "7.4.8",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "packageManager": "bun@1.4.4"
}

{
  "name": "purdue-hackers-jukebox",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "scripts/run-dev",
    "build": "bun --bun astro build",
    "start": "scripts/run-production",
    "test": "bun test --preload ./tests/preload.ts tests/*.test.ts tests/turn.test.mjs",
    "test:policy": "bun test --preload ./tests/preload.ts tests/turn.test.mjs",
    "typecheck": "bun --bun astro check && bun --bun tsc -p .",
    "check": "scripts/check",
    "worker": "uv run --locked python -m jukebox.server"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@tailwindcss/vite": "^4.3.4",
    "@types/bun": "1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.4",
    "typescript": "6.0.3"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "dependencies": {
    "@astrojs/node": "11.1.11",
    "@astrojs/react": "^7.1.9",
    "@fontsource/inconsolata": "^5.3.0",
    "@paper-design/shaders": "0.0.82",
    "@purduehackers/time": "^0.7.0",
    "@sentry/bun": "^11.13.0",
    "@sentry/react": "^11.13.0",
    "astro": "7.4.8",
    "butterchurn": "3.0.0-beta.5",
    "butterchurn-presets": "3.0.0-beta.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "packageManager": "bun@1.4.4"
}
